API_BASE_URL=https://omni-api.app.sunriseieco.vn
APP_NAME=Viomni

# Realtime (Laravel Reverb, Pusher protocol). Empty disables it: the app then
# falls back to polling /inbox/changes, which is slower but never wrong.
# REALTIME_KEY must match REVERB_APP_KEY on the API.
REALTIME_KEY=
REALTIME_HOST=
# Defaults to 443 for https, 80 for http. A directly-exposed Reverb uses 8080.
# REALTIME_PORT=
# REALTIME_SCHEME=https
