API_BASE_URL=https://omni-api.app.sunriseieco.vn
APP_NAME=Viomni

# Realtime (Laravel Reverb, Pusher protocol). Empty disables it: the app then
# falls back to polling /inbox/changes, which is slower but never wrong.
# REALTIME_KEY must match REVERB_APP_KEY on the API.
#
# CẢNH BÁO: để trống là app TẮT HẲN realtime, và triệu chứng của nó rất dễ đọc
# nhầm — không lỗi, không log, mọi màn hình vẫn chạy đúng, chỉ là không bao giờ
# TỰ cập nhật. Trên màn Dòng việc, "đứng yên" trông y hệt "chưa có gì xảy ra".
#
# Giá trị cho môi trường dev, khớp với docker-compose.local.yml bên omni-flow-api
# (dựng bằng: docker compose -f docker-compose.dev.yml -f docker-compose.local.yml up -d):
#
#   REALTIME_KEY=omnicrm-local-key
#   REALTIME_HOST=localhost
#   REALTIME_PORT=8081
#   REALTIME_SCHEME=http
#
# Hoặc truyền thẳng khi chạy, không phải sửa .env:
#   flutter run -d chrome \
#     --dart-define=API_BASE_URL=http://localhost:8000 \
#     --dart-define=REALTIME_KEY=omnicrm-local-key \
#     --dart-define=REALTIME_HOST=localhost \
#     --dart-define=REALTIME_PORT=8081 \
#     --dart-define=REALTIME_SCHEME=http
REALTIME_KEY=
REALTIME_HOST=
# Defaults to 443 for https, 80 for http. A directly-exposed Reverb uses 8080.
# REALTIME_PORT=
# REALTIME_SCHEME=https
