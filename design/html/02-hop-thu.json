{"data":{"id":"0OYqsRTi9o5","name":"Hộp thư","activeVersion":1,"versions":[{"id":"Fqem4HyLGZG","version":1,"code":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>HộpThư</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js\"></script>\n    <style type=\"text/tailwindcss\">\n      @theme inline {\n        --color-background: var(--background);\n        --color-foreground: var(--foreground);\n        --color-primary: var(--primary);\n        --color-primary-foreground: var(--primary-foreground);\n        --color-secondary: var(--secondary);\n        --color-secondary-foreground: var(--secondary-foreground);\n        --color-muted: var(--muted);\n        --color-muted-foreground: var(--muted-foreground);\n        --color-accent: var(--accent);\n        --color-accent-foreground: var(--accent-foreground);\n        --color-destructive: var(--destructive);\n        --color-card: var(--card);\n        --color-card-foreground: var(--card-foreground);\n        --color-popover: var(--popover);\n        --color-popover-foreground: var(--popover-foreground);\n        --color-border: var(--border);\n        --color-input: var(--input);\n        --color-ring: var(--ring);\n        --color-chart-1: var(--chart-1);\n        --color-chart-2: var(--chart-2);\n        --color-chart-3: var(--chart-3);\n        --color-chart-4: var(--chart-4);\n        --color-chart-5: var(--chart-5);\n\n        --font-font-sans: var(--font-sans);\n        --font-font-heading: var(--font-heading);\n        --font-font-serif: var(--font-serif);\n        --font-font-mono: var(--font-mono);\n      }\n\n      @theme {\n        --radius-xs: calc(var(--radius) - 8px);\n        --radius-sm: calc(var(--radius) - 4px);\n        --radius-md: calc(var(--radius) - 2px);\n        --radius-lg: var(--radius);\n        --radius-xl: calc(var(--radius) + 4px);\n        --radius-2xl: calc(var(--radius) + 8px);\n        --radius-3xl: calc(var(--radius) + 16px);\n        --radius-4xl: calc(var(--radius) + 24px);\n      }\n\n      * {\n        corner-shape: var(--shape, round);\n      }\n\n      .rounded-full,\n      .rounded-none,\n      .rounded-t-full,\n      .rounded-t-none,\n      .rounded-r-full,\n      .rounded-r-none,\n      .rounded-b-full,\n      .rounded-b-none,\n      .rounded-l-full,\n      .rounded-l-none,\n      .rounded-s-full,\n      .rounded-s-none,\n      .rounded-e-full,\n      .rounded-e-none,\n      .rounded-tl-full,\n      .rounded-tl-none,\n      .rounded-tr-full,\n      .rounded-tr-none,\n      .rounded-bl-full,\n      .rounded-bl-none,\n      .rounded-br-full,\n      .rounded-br-none,\n      .rounded-ss-full,\n      .rounded-ss-none,\n      .rounded-se-full,\n      .rounded-se-none,\n      .rounded-es-full,\n      .rounded-es-none,\n      .rounded-ee-full,\n      .rounded-ee-none {\n        corner-shape: round;\n      }\n\n      @utility rounded-* {\n        border-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-t-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-r-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-b-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-l-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tl-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tr-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-bl-* {\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-br-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-s-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-e-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ss-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-se-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-es-* {\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ee-* {\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n\n      :root {\n        --shape: squircle;\n        --shape-multiplier: 1;\n\n        --background: #f8f9fb;\n        --foreground: #0f172a;\n        --primary: #4338ca;\n        --primary-foreground: #ffffff;\n        --secondary: #e2e8f0;\n        --secondary-foreground: #1e293b;\n        --muted: #f1f5f9;\n        --muted-foreground: #64748b;\n        --accent: #eef2ff;\n        --accent-foreground: #4338ca;\n        --destructive: #ef4444;\n        --card: #ffffff;\n        --card-foreground: #0f172a;\n        --popover: #ffffff;\n        --popover-foreground: #0f172a;\n        --border: #e2e8f0;\n        --input: #f8f9fb;\n        --ring: #4338ca;\n        --chart-1: #0ea5e9;\n        --chart-2: #1877f2;\n        --chart-3: #10b981;\n        --chart-4: #ec4899;\n        --chart-5: #0f172a;\n\n        --font-sans: \"Inter\";\n        --font-heading: \"Inter\";\n        --font-serif: \"Playfair Display\";\n        --font-mono: \"JetBrains Mono\";\n\n        --radius: 1rem;\n      }\n\n      @supports (corner-shape: squircle) {\n        :root {\n          --shape-multiplier: 2.5;\n        }\n      }\n\n      /* Prevent layout shift for icons without explicit dimensions */\n      iconify-icon:not([width]):not([height]) {\n        display: inline-block;\n        width: 1em;\n        height: 1em;\n      }\n\n      /* Hide scrollbars */\n      *,\n      *::before,\n      *::after {\n        scrollbar-width: none;\n        -ms-overflow-style: none;\n      }\n      *::-webkit-scrollbar {\n        display: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      class=\"flex flex-col min-h-screen bg-background text-foreground font-sans selection:bg-primary/10\"\n    >\n      <div\n        class=\"sticky top-0 z-30 bg-background/80 backdrop-blur-md border-b border-border/40 px-4 pt-3 pb-2 space-y-3\"\n      >\n        <div class=\"flex items-center justify-between\">\n          <h1 class=\"text-xl font-bold tracking-tight font-heading\">Hộp thư</h1>\n          <div class=\"flex items-center gap-3\">\n            <button\n              type=\"button\"\n              class=\"size-9 rounded-full flex items-center justify-center bg-muted hover:bg-secondary transition-colors\"\n            >\n              <iconify-icon\n                icon=\"solar:checklist-minimalistic-linear\"\n                width=\"20\"\n                height=\"20\"\n              ></iconify-icon></button\n            ><button type=\"button\" class=\"size-9 rounded-full overflow-hidden border border-border\">\n              <img\n                alt=\"Me\"\n                src=\"https://randomuser.me/api/portraits/men/32.jpg\"\n                class=\"size-full object-cover\"\n              />\n            </button>\n          </div>\n        </div>\n        <div class=\"relative group\">\n          <span\n            class=\"absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground group-focus-within:text-primary transition-colors\"\n            ><iconify-icon icon=\"solar:magnifer-linear\" width=\"20\" height=\"20\"></iconify-icon></span\n          ><input\n            type=\"text\"\n            class=\"w-full bg-muted/60 border-none rounded-squircle py-2.5 pl-10 pr-4 text-sm focus:ring-2 focus:ring-primary/10 outline-none transition-all\"\n            placeholder=\"Tìm kiếm hội thoại...\"\n          />\n        </div>\n      </div>\n      <div class=\"bg-background z-20\">\n        <div class=\"flex overflow-x-auto no-scrollbar py-3 px-4 gap-2\">\n          <button\n            type=\"button\"\n            class=\"whitespace-nowrap px-4 py-1.5 rounded-full bg-primary text-primary-foreground text-sm font-semibold flex items-center gap-1.5 shadow-sm shadow-primary/20\"\n          >\n            <span>Tất cả</span\n            ><span\n              class=\"bg-primary-foreground/20 px-1.5 py-0.5 rounded-full text-[10px] tabular-nums\"\n              >128</span\n            ></button\n          ><button\n            type=\"button\"\n            class=\"whitespace-nowrap px-4 py-1.5 rounded-full bg-white border border-border text-foreground text-sm font-medium flex items-center gap-1.5 hover:bg-muted/50 transition-colors\"\n          >\n            <span>Chưa đọc</span\n            ><span\n              class=\"bg-destructive text-white px-1.5 py-0.5 rounded-full text-[10px] tabular-nums\"\n              >12</span\n            ></button\n          ><button\n            type=\"button\"\n            class=\"whitespace-nowrap px-4 py-1.5 rounded-full bg-white border border-border text-foreground text-sm font-medium flex items-center gap-1.5 hover:bg-muted/50 transition-colors\"\n          >\n            <span>Của tôi</span\n            ><span\n              class=\"bg-muted-foreground/20 text-muted-foreground px-1.5 py-0.5 rounded-full text-[10px] tabular-nums\"\n              >45</span\n            ></button\n          ><button\n            type=\"button\"\n            class=\"whitespace-nowrap px-4 py-1.5 rounded-full bg-white border border-border text-foreground text-sm font-medium flex items-center gap-1.5 hover:bg-muted/50 transition-colors\"\n          >\n            <span>Chưa gán</span\n            ><span\n              class=\"bg-muted-foreground/20 text-muted-foreground px-1.5 py-0.5 rounded-full text-[10px] tabular-nums\"\n              >8</span\n            ></button\n          ><button\n            type=\"button\"\n            class=\"whitespace-nowrap px-4 py-1.5 rounded-full bg-white border border-border text-foreground text-sm font-medium flex items-center gap-1.5 hover:bg-muted/50 transition-colors\"\n          >\n            <span>Khẩn</span\n            ><span\n              class=\"bg-amber-500/10 text-amber-600 px-1.5 py-0.5 rounded-full text-[10px] tabular-nums\"\n              >3</span\n            >\n          </button>\n        </div>\n        <div class=\"flex overflow-x-auto no-scrollbar pb-3 px-4 gap-4 border-b border-border/40\">\n          <button type=\"button\" class=\"flex flex-col items-center gap-1 min-w-fit group\">\n            <div\n              class=\"size-10 rounded-squircle bg-muted flex items-center justify-center group-hover:bg-secondary transition-colors border border-border/40\"\n            >\n              <iconify-icon icon=\"solar:globus-linear\" width=\"20\" height=\"20\"></iconify-icon>\n            </div>\n            <span class=\"text-[10px] font-medium text-muted-foreground\">Tất cả</span></button\n          ><button type=\"button\" class=\"flex flex-col items-center gap-1 min-w-fit group\">\n            <div\n              class=\"size-10 rounded-squircle bg-[#0EA5E9]/10 flex items-center justify-center border border-[#0EA5E9]/20\"\n            >\n              <iconify-icon\n                icon=\"simple-icons:zalo\"\n                class=\"text-[#0EA5E9]\"\n 