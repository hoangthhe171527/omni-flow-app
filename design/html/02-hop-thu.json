s=\"bg-muted px-2 py-0.5 rounded text-[10px] font-medium text-muted-foreground border border-border/50\"\n                  >Gia đình</span\n                >\n                <div\n                  class=\"flex items-center gap-1 text-[10px] font-medium text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200\"\n                >\n                  <iconify-icon\n                    icon=\"solar:clock-circle-linear\"\n                    width=\"12\"\n                    height=\"12\"\n                  ></iconify-icon\n                  ><span>12p</span>\n                </div>\n              </div>\n              <div class=\"flex items-center gap-1.5 shrink-0\">\n                <img\n                  alt=\"Assignee\"\n                  src=\"https://randomuser.me/api/portraits/men/32.jpg\"\n                  class=\"size-4.5 rounded-full border border-white shadow-sm\"\n                />\n                <div\n                  class=\"bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full tabular-nums\"\n                >\n                  3\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div\n          class=\"group relative flex gap-3 px-4 py-4 bg-amber-50/30 border-b border-border/40 active:bg-muted/30 transition-colors\"\n        >\n          <div class=\"absolute left-0 top-0 bottom-0 w-[3px] bg-[#1877F2]\"></div>\n          <div class=\"relative shrink-0\">\n            <div\n              class=\"size-12 rounded-full bg-gradient-to-br from-indigo-100 to-indigo-200 flex items-center justify-center shadow-sm\"\n            >\n              <span class=\"text-sm font-bold text-indigo-700 font-heading\">TP</span>\n            </div>\n            <iconify-icon\n              icon=\"solar:fire-bold\"\n              class=\"absolute -top-1 -left-1 text-destructive\"\n              width=\"20\"\n              height=\"20\"\n            ></iconify-icon>\n          </d