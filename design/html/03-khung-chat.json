{"data":{"id":"rz1dwHUSoKe","name":"Khung chat","activeVersion":1,"versions":[{"id":"JukvhcboQIa","version":1,"code":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>KhungChat</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js\"></script>\n    <style type=\"text/tailwindcss\">\n      @theme inline {\n        --color-background: var(--background);\n        --color-foreground: var(--foreground);\n        --color-primary: var(--primary);\n        --color-primary-foreground: var(--primary-foreground);\n        --color-secondary: var(--secondary);\n        --color-secondary-foreground: var(--secondary-foreground);\n        --color-muted: var(--muted);\n        --color-muted-foreground: var(--muted-foreground);\n        --color-accent: var(--accent);\n        --color-accent-foreground: var(--accent-foreground);\n        --color-destructive: var(--destructive);\n        --color-card: var(--card);\n        --color-card-foreground: var(--card-foreground);\n        --color-popover: var(--popover);\n        --color-popover-foreground: var(--popover-foreground);\n        --color-border: var(--border);\n        --color-input: var(--input);\n        --color-ring: var(--ring);\n        --color-chart-1: var(--chart-1);\n        --color-chart-2: var(--chart-2);\n        --color-chart-3: var(--chart-3);\n        --color-chart-4: var(--chart-4);\n        --color-chart-5: var(--chart-5);\n\n        --font-font-sans: var(--font-sans);\n        --font-font-heading: var(--font-heading);\n        --font-font-serif: var(--font-serif);\n        --font-font-mono: var(--font-mono);\n      }\n\n      @theme {\n        --radius-xs: calc(var(--radius) - 8px);\n        --radius-sm: calc(var(--radius) - 4px);\n        --radius-md: calc(var(--radius) - 2px);\n        --radius-lg: var(--radius);\n        --radius-xl: calc(var(--radius) + 4px);\n        --radius-2xl: calc(var(--radius) + 8px);\n        --radius-3xl: calc(var(--radius) + 16px);\n        --radius-4xl: calc(var(--radius) + 24px);\n      }\n\n      * {\n        corner-shape: var(--shape, round);\n      }\n\n      .rounded-full,\n      .rounded-none,\n      .rounded-t-full,\n      .rounded-t-none,\n      .rounded-r-full,\n      .rounded-r-none,\n      .rounded-b-full,\n      .rounded-b-none,\n      .rounded-l-full,\n      .rounded-l-none,\n      .rounded-s-full,\n      .rounded-s-none,\n      .rounded-e-full,\n      .rounded-e-none,\n      .rounded-tl-full,\n      .rounded-tl-none,\n      .rounded-tr-full,\n      .rounded-tr-none,\n      .rounded-bl-full,\n      .rounded-bl-none,\n      .rounded-br-full,\n      .rounded-br-none,\n      .rounded-ss-full,\n      .rounded-ss-none,\n      .rounded-se-full,\n      .rounded-se-none,\n      .rounded-es-full,\n      .rounded-es-none,\n      .rounded-ee-full,\n      .rounded-ee-none {\n        corner-shape: round;\n      }\n\n      @utility rounded-* {\n        border-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-t-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-r-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-b-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-l-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tl-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tr-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-bl-* {\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-br-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-s-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-e-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ss-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-se-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-es-* {\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ee-* {\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n\n      :root {\n        --shape: squircle;\n        --shape-multiplier: 1;\n\n        --background: #f8f9fb;\n        --foreground: #0f172a;\n        --primary: #4338ca;\n        --primary-foreground: #ffffff;\n        --secondary: #e2e8f0;\n        --secondary-foreground: #1e293b;\n        --muted: #f1f5f9;\n        --muted-foreground: #64748b;\n        --accent: #eef2ff;\n        --accent-foreground: #4338ca;\n        --destructive: #ef4444;\n        --card: #ffffff;\n        --card-foreground: #0f172a;\n        --popover: #ffffff;\n        --popover-foreground: #0f172a;\n        --border: #e2e8f0;\n        --input: #f8f9fb;\n        --ring: #4338ca;\n        --chart-1: #0ea5e9;\n        --chart-2: #1877f2;\n        --chart-3: #10b981;\n        --chart-4: #ec4899;\n        --chart-5: #0f172a;\n\n        --font-sans: \"Inter\";\n        --font-heading: \"Inter\";\n        --font-serif: \"Playfair Display\";\n        --font-mono: \"JetBrains Mono\";\n\n        --radius: 1rem;\n      }\n\n      @supports (corner-shape: squircle) {\n        :root {\n          --shape-multiplier: 2.5;\n        }\n      }\n\n      /* Prevent layout shift for icons without explicit dimensions */\n      iconify-icon:not([width]):not([height]) {\n        display: inline-block;\n        width: 1em;\n        height: 1em;\n      }\n\n      /* Hide scrollbars */\n      *,\n      *::before,\n      *::after {\n        scrollbar-width: none;\n        -ms-overflow-style: none;\n      }\n      *::-webkit-scrollbar {\n        display: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      class=\"flex flex-col h-screen bg-background text-foreground font-sans selection:bg-primary/10\"\n    >\n      <div\n        class=\"sticky top-0 z-30 bg-card/95 backdrop-blur-md border-b border-border/40 px-3 py-2.5 flex items-center justify-between shadow-sm\"\n      >\n        <div class=\"flex items-center gap-3 min-w-0\">\n          <button type=\"button\" class=\"size-8 flex items-center justify-center -ml-1\">\n            <iconify-icon icon=\"solar:alt-arrow-left-linear\" width=\"24\" height=\"24\"></iconify-icon>\n          </button>\n          <div class=\"flex items-center gap-3 min-w-0\">\n            <div class=\"relative shrink-0\">\n              <img\n                alt=\"User\"\n                src=\"https://randomuser.me/api/portraits/women/44.jpg\"\n                class=\"size-10 rounded-full object-cover border border-border/50\"\n              />\n              <div class=\"absolute -bottom-0.5 -right-0.5 size-3.5 rounded-full bg-card p-0.5\">\n                <div class=\"size-full rounded-full bg-green-500 border border-white\"></div>\n              </div>\n            </div>\n            <div class=\"min-w-0\">\n              <h2 class=\"text-[15px] font-bold tracking-tight truncate leading-tight\">\n                Nguyễn Thu Hà\n              </h2>\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-[10px] text-[#0EA5E9] font-bold\">ZALO CA NHAN</span\n                ><span class=\"size-1 rounded-full bg-muted-foreground/30\"></span\n                ><span class=\"text-[10px] text-muted-foreground font-medium animate-pulse\"\n                  >Đang nhập...</span\n                >\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex items-center gap-1\">\n          <button\n            type=\"button\"\n            class=\"size-9 rounded-full flex items-center justify-center hover:bg-muted transition-colors text-primary\"\n          >\n            <iconify-icon\n              icon=\"solar:phone-calling-linear\"\n              width=\"20\"\n              height=\"20\"\n            ></iconify-icon></button\n          ><button\n            type=\"button\"\n            class=\"size-9 rounded-full flex items-center justify-center hover:bg-muted transition-colors\"\n          >\n            <iconify-icon\n              icon=\"solar:user-plus-linear\"\n              width=\"20\"\n              height=\"20\"\n            ></iconify-icon></button\n          ><button\n            type=\"button\"\n            class=\"size-9 rounded-full flex items-center justify-center hover:bg-muted transition-colors\"\n          >\n            <iconify-icon icon=\"solar:info-circle-linear\" width=\"20\" height=\"20\"></iconify-icon>\n          </button>\n        </div>\n      </div>\n      <div class=\"flex-1 overflow-y-auto px-4 py-4 space-y-6\">\n        <div class=\"flex items-center justify-center\">\n          <div class=\"h-px flex-1 bg-border/40\"></div>\n          <span class=\"px-3 text-[10px] font-bold text-muted-foreground uppercase tracking-wider\"\n            >Hôm qua, 14 Th05</span\n          >\n          <div class=\"h-px flex-1 bg-border/40\"></div>\n        </div>\n        <div class=\"flex items-start gap-2.5 max-w-[85%]\">\n          <img\n            alt=\"User\"\n            src=\"https://randomuser.me/api/portraits/women/44.jpg\"\n            class=\"size-8 rounded-full object-cover shrink-0 mt-0.5\"\n          />\n          <div class=\"space-y-1\">\n            <div\n              class=\"bg-white border border-border/60 p-3 rounded-2xl rounded-tl-none shadow-sm relative group\"\n            >\n              <p class=\"text-sm leading-relaxed\">\n                Chào shop, mình muốn hỏi về chính sách bảo hành của máy này. Nếu bị lỗi do nhà sản\n                xuất thì đổi mới trong bao lâu vậy ạ?\n              </p>\n              <div class=\"absolute -bottom-2 -right-1 flex gap-0.5\">\n                <div\n                  class=\"bg-card border border-border rounded-full px-1.5 py-0.5 shadow-sm flex items-center text-[10px]\"\n                >\n                  <span>❤️</span>\n                </div>\n              </div>\n            </div>\n            <span class=\"text-[10px] font-medium text-muted-foreground ml-1\">14:20</span>\n          </div>\n        </div>\n        <div class=\"flex items-end justify-end gap-2 text-right\">\n          <div class=\"space-y-1 max-w-[85%]\">\n            <div\n              class=\"bg-primary text-primary-foreground p-3 rounded-2xl rounded-tr-none shadow-md shadow-primary/10\"\n            >\n              <p class=\"text-sm leading-relaxed\">\n                Dạ chào chị Hà ạ, cảm ơn chị đã quan tâm! Sản phẩm này bên em bảo hành 12 tháng, lỗi\n                1 đổi 1 trong vòng 30 ngày đầu tiên nếu có lỗi kỹ thuật chị nhé.\n              </p>\n            </div>\n            <div class=\"flex items-center justify-end gap-1.5 ml-1\">\n              <span class=\"text-[10px] font-medium text-muted-foreground\">14:22</span\n              ><iconify-icon\n                icon=\"solar:check-read-linear\"\n                class=\"text-primary\"\n                width=\"12\"\n                height=\"12\"\n              ></iconify-icon>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex justify-center\">\n          <div class=\"bg-amber-50 border border-amber-100 rounded-xl p-3 max-w-[90%] space-y-2\">\n            <div class=\"flex items-center gap-2 border-b border-amber-200/50 pb-1.5\">\n              <iconify-icon\n                icon=\"solar:notes-bold\"\n                class=\"text-amber-600\"\n                width=\"16\"\n                height=\"16\"\n              ></iconify-icon\n              ><span class=\"text-[10px] font-bold text-amber-800 uppercase tracking-tight\"\n                >Ghi chú nội bộ</span\n              >\n            </div>\n            <p class=\"text-xs text-amber-900 leading-relaxed\">\n              Khách này đang quan tâm dòng Pro Max, đã tư vấn bảo hành nhưng còn phân vân về giá.\n              Rep sau lưu ý tặng thêm voucher 200k nếu cần chốt nhanh.\n            </p>\n            <div class=\"flex items-center justify-between pt-0.5\">\n              <span class=\"text-[9px] font-medium text-amber-700/60\">Bởi: Kiệt Nguyễn · 14:25</span\n              ><img\n                alt=\"Me\"\n                src=\"https://randomuser.me/api/portraits/men/32.jpg\"\n                class=\"size-4 rounded-full\"\n              />\n            </div>\n          </div>\n        </div>\n        <div class=\"flex items-end justify-end gap-2\">\n          <div class=\"space-y-1 max-w-[70%]\">\n            <div class=\"bg-white p-1 rounded-2xl border border-border overflow-hidden shadow-sm\">\n              <img\n                alt=\"Attachment\"\n                src=\"https://ggrhecslgdflloszjkwl.supabase.co/storage/v1/object/public/generation-assets/placeholder/landscape.png\"\n                class=\"w-full h-40 object-cover rounded-xl\"\n              />\n            </div>\n            <div class=\"flex items-center justify-end gap-1.5\">\n              <span class=\"text-[10px] font-medium text-muted-foreground\">14:26</span\n              ><iconify-icon\n                icon=\"solar:check-read-linear\"\n                class=\"text-primary\"\n                width=\"12\"\n                height=\"12\"\n              ></iconify-icon>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex items-end justify-end gap-2\">\n          <div class=\"space-y-1 max-w-[85%] text-right\">\n            <div\n              class=\"bg-muted text-muted-foreground p-3 rounded-2xl rounded-tr-none border border-border\"\n            >\n              <p class=\"text-sm leading-relaxed\">\n                Chị có thể tham khảo thêm link này ạ: bit.ly/product-catalogue\n              </p>\n            </div>\n            <div class=\"flex items-center justify-end gap-1.5\">\n              <span class=\"text-[10px] font-medium text-destructive\">Gửi lỗi: Mất kết nối API</span\n              ><iconify-icon\n                icon=\"solar:danger-bold\"\n                class=\"text-destructive\"\n                width=\"14\"\n                height=\"14\"\n              ></iconify-icon\n              ><button class=\"text-[10px] font-bold text-primary underline\">Thử lại</button>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex items-start gap-2.5 max-w-[85%]\">\n          <div class=\"size-8 shrink-0\"></div>\n          <div\n            class=\"bg-muted/30 border border-border/40 px-3 py-2 rounded-2xl rounded-tl-none italic text-muted-foreground text-[13px]\"\n          >\n            Tin nhắn đã được thu hồi\n          </div>\n        </div>\n      </div>\n      <div class=\"bg-card border-t border-border px-3 pt-2 pb-6 space-y-3\">\n        <div class=\"flex overflow-x-auto no-scrollbar gap-2 -mx-3 px-3\">\n          <button\n            class=\"whitespace-nowrap bg-muted hover:bg-secondary px-3 py-1.5 rounded-full text-xs font-medium text-foreground transition-colors border border-border/60 shrink-0\"\n          >\n            Cho mình xem mẫu?</button\n          ><button\n            class=\"whitespace-nowrap bg-muted hover:bg-secondary px-3 py-1.5 rounded-full text-xs font-medium text-foreground transition-colors border border-border/60 shrink-0\"\n          >\n            Cảm ơn chị đã quan tâm</button\n          ><button\n            class=\"whitespace-nowrap bg-muted hover:bg-secondary px-3 py-1.5 rounded-full text-xs font-medium text-foreground transition-colors border border-border/60 shrink-0\"\n          >\n            Shop đang có khuyến mãi...\n          </button>\n        </div>\n        <div class=\"flex flex-col bg-muted/50 rounded-[1.25rem] border border-border p-1.5\">\n          <div class=\"flex gap-1 mb-1.5\">\n            <button\n              class=\"flex-1 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-wider bg-white shadow-sm text-primary flex items-center justify-center gap-1.5\"\n            >\n              <iconify-icon icon=\"solar:chat-round-linear\" width=\"14\" height=\"14\"></iconify-icon>Trả\n              lời khách</button\n            ><button\n              class=\"flex-1 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-wider text-muted-foreground hover:bg-white/50 transition-colors flex items-center justify-center gap-1.5\"\n            >\n              <iconify-icon icon=\"solar:notes-linear\" width=\"14\" height=\"14\"></iconify-icon>Ghi chú\n              nội bộ\n            </button>\n          </div>\n          <div class=\"flex items-end gap-2 px-2 pb-1.5\">\n            <button\n              class=\"size-9 rounded-full flex items-center justify-center text-muted-foreground hover:bg-muted transition-colors shrink-0\"\n            >\n              <iconify-icon\n                icon=\"solar:add-circle-linear\"\n                width=\"24\"\n                height=\"24\"\n              ></iconify-icon></button\n            ><textarea\n              rows=\"1\"\n              class=\"flex-1 bg-transparent border-none py-2 text-sm outline-none resize-none max-h-32\"\n              placeholder=\"Nhập nội dung...\"\n            ></textarea\n            ><button\n              class=\"size-9 rounded-full flex items-center justify-center text-muted-foreground hover:bg-muted transition-colors shrink-0\"\n            >\n              <iconify-icon\n                icon=\"solar:smile-circle-linear\"\n                width=\"24\"\n                height=\"24\"\n              ></iconify-icon></button\n            ><button\n              class=\"size-9 rounded-full bg-primary text-white flex items-center justify-center shrink-0 shadow-md shadow-primary/20\"\n            >\n              <iconify-icon\n                icon=\"solar:plain-bold\"\n                class=\"rotate-45\"\n                width=\"20\"\n                height=\"20\"\n              ></iconify-icon>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </body>\n</html>\n","createdAt":"2026-08-03T02:51:12.130201+00:00"}],"createdAt":"2026-08-03T02:51:12.130201+00:00","updatedAt":"2026-08-03T02:51:12.130201+00:00"}}