{"data":{"id":"puPcqWGiGjI","name":"Đăng nhập","activeVersion":1,"versions":[{"id":"zBLQqp4stgi","version":1,"code":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>ĐăngNhập</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js\"></script>\n    <style type=\"text/tailwindcss\">\n      @theme inline {\n        --color-background: var(--background);\n        --color-foreground: var(--foreground);\n        --color-primary: var(--primary);\n        --color-primary-foreground: var(--primary-foreground);\n        --color-secondary: var(--secondary);\n        --color-secondary-foreground: var(--secondary-foreground);\n        --color-muted: var(--muted);\n        --color-muted-foreground: var(--muted-foreground);\n        --color-accent: var(--accent);\n        --color-accent-foreground: var(--accent-foreground);\n        --color-destructive: var(--destructive);\n        --color-card: var(--card);\n        --color-card-foreground: var(--card-foreground);\n        --color-popover: var(--popover);\n        --color-popover-foreground: var(--popover-foreground);\n        --color-border: var(--border);\n        --color-input: var(--input);\n        --color-ring: var(--ring);\n        --color-chart-1: var(--chart-1);\n        --color-chart-2: var(--chart-2);\n        --color-chart-3: var(--chart-3);\n        --color-chart-4: var(--chart-4);\n        --color-chart-5: var(--chart-5);\n\n        --font-font-sans: var(--font-sans);\n        --font-font-heading: var(--font-heading);\n        --font-font-serif: var(--font-serif);\n        --font-font-mono: var(--font-mono);\n      }\n\n      @theme {\n        --radius-xs: calc(var(--radius) - 8px);\n        --radius-sm: calc(var(--radius) - 4px);\n        --radius-md: calc(var(--radius) - 2px);\n        --radius-lg: var(--radius);\n        --radius-xl: calc(var(--radius) + 4px);\n        --radius-2xl: calc(var(--radius) + 8px);\n        --radius-3xl: calc(var(--radius) + 16px);\n        --radius-4xl: calc(var(--radius) + 24px);\n      }\n\n      * {\n        corner-shape: var(--shape, round);\n      }\n\n      .rounded-full,\n      .rounded-none,\n      .rounded-t-full,\n      .rounded-t-none,\n      .rounded-r-full,\n      .rounded-r-none,\n      .rounded-b-full,\n      .rounded-b-none,\n      .rounded-l-full,\n      .rounded-l-none,\n      .rounded-s-full,\n      .rounded-s-none,\n      .rounded-e-full,\n      .rounded-e-none,\n      .rounded-tl-full,\n      .rounded-tl-none,\n      .rounded-tr-full,\n      .rounded-tr-none,\n      .rounded-bl-full,\n      .rounded-bl-none,\n      .rounded-br-full,\n      .rounded-br-none,\n      .rounded-ss-full,\n      .rounded-ss-none,\n      .rounded-se-full,\n      .rounded-se-none,\n      .rounded-es-full,\n      .rounded-es-none,\n      .rounded-ee-full,\n      .rounded-ee-none {\n        corner-shape: round;\n      }\n\n      @utility rounded-* {\n        border-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-t-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-r-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-b-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-l-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tl-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tr-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-bl-* {\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-br-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-s-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-e-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ss-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-se-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-es-* {\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ee-* {\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n\n      :root {\n        --shape: squircle;\n        --shape-multiplier: 1;\n\n        --background: #f8f9fb;\n        --foreground: #0f172a;\n        --primary: #4338ca;\n        --primary-foreground: #ffffff;\n        --secondary: #e2e8f0;\n        --secondary-foreground: #1e293b;\n        --muted: #f1f5f9;\n        --muted-foreground: #64748b;\n        --accent: #eef2ff;\n        --accent-foreground: #4338ca;\n        --destructive: #ef4444;\n        --card: #ffffff;\n        --card-foreground: #0f172a;\n        --popover: #ffffff;\n        --popover-foreground: #0f172a;\n        --border: #e2e8f0;\n        --input: #f8f9fb;\n        --ring: #4338ca;\n        --chart-1: #0ea5e9;\n        --chart-2: #1877f2;\n        --chart-3: #10b981;\n        --chart-4: #ec4899;\n        --chart-5: #0f172a;\n\n        --font-sans: \"Inter\";\n        --font-heading: \"Inter\";\n        --font-serif: \"Playfair Display\";\n        --font-mono: \"JetBrains Mono\";\n\n        --radius: 1rem;\n      }\n\n      @supports (corner-shape: squircle) {\n        :root {\n          --shape-multiplier: 2.5;\n        }\n      }\n\n      /* Prevent layout shift for icons without explicit dimensions */\n      iconify-icon:not([width]):not([height]) {\n        display: inline-block;\n        width: 1em;\n        height: 1em;\n      }\n\n      /* Hide scrollbars */\n      *,\n      *::before,\n      *::after {\n        scrollbar-width: none;\n        -ms-overflow-style: none;\n      }\n      *::-webkit-scrollbar {\n        display: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      class=\"flex flex-col min-h-screen bg-background text-foreground font-sans relative overflow-hidden\"\n    >\n      <div\n        class=\"absolute top-0 inset-x-0 h-[45vh] bg-gradient-to-b from-primary/10 to-transparent pointer-events-none\"\n      ></div>\n      <div class=\"flex-1 flex flex-col justify-center px-4 relative z-10 pb-10\">\n        <div class=\"w-full max-w-md mx-auto space-y-8\">\n          <div class=\"space-y-4\">\n            <div\n              class=\"size-12 rounded-squircle bg-gradient-to-tr from-primary to-[#6366F1] flex items-center justify-center text-primary-foreground shadow-md shadow-primary/20\"\n            >\n              <iconify-icon\n                icon=\"solar:layers-minimalistic-bold\"\n                width=\"24\"\n                height=\"24\"\n              ></iconify-icon>\n            </div>\n            <div class=\"space-y-1.5\">\n              <h1 class=\"text-2xl font-semibold tracking-tight font-heading text-foreground\">\n                Chào mừng trở lại\n              </h1>\n              <p class=\"text-sm text-muted-foreground leading-relaxed\">\n                Nhập thông tin để tiếp tục xử lý công việc và hỗ trợ khách hàng.\n              </p>\n            </div>\n          </div>\n          <div\n            class=\"bg-card border border-border/60 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)] rounded-squircle p-5 space-y-6 relative overflow-hidden\"\n          >\n            <div class=\"space-y-4\">\n              <div class=\"space-y-2\">\n                <label class=\"text-sm font-medium text-foreground ml-1\">Email làm việc</label>\n                <div class=\"relative group\">\n                  <span\n                    class=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-muted-foreground group-focus-within:text-primary transition-colors flex items-center\"\n                    ><iconify-icon\n                      icon=\"solar:letter-linear\"\n                      width=\"20\"\n                      height=\"20\"\n                    ></iconify-icon></span\n                  ><input\n                    type=\"email\"\n                    class=\"w-full bg-input border border-border rounded-squircle py-3 pl-11 pr-4 text-sm font-medium text-foreground outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all\"\n                    placeholder=\"hoang.nguyen@congty.vn\"\n                    value=\"hoang.nguyen@congty.vn\"\n                  />\n                </div>\n              </div>\n              <div class=\"space-y-2\">\n                <div class=\"flex items-center justify-between ml-1\">\n                  <label class=\"text-sm font-medium text-foreground\">Mật khẩu</label\n                  ><a\n                    href=\"#\"\n                    class=\"text-xs font-medium text-primary hover:text-primary/80 transition-colors\"\n                    >Quên mật khẩu?</a\n                  >\n                </div>\n                <div class=\"relative group\">\n                  <span\n                    class=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-muted-foreground group-focus-within:text-primary transition-colors flex items-center\"\n                    ><iconify-icon\n                      icon=\"solar:lock-password-linear\"\n                      width=\"20\"\n                      height=\"20\"\n                    ></iconify-icon></span\n                  ><input\n                    type=\"password\"\n                    class=\"w-full bg-input border border-border rounded-squircle py-3 pl-11 pr-11 text-sm font-medium text-foreground outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all\"\n                    value=\"••••••••\"\n                  /><button\n                    type=\"button\"\n                    class=\"absolute right-3.5 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors flex items-center\"\n                  >\n                    <iconify-icon icon=\"solar:eye-linear\" width=\"20\" height=\"20\"></iconify-icon>\n                  </button>\n                </div>\n              </div>\n            </div>\n            <button\n              type=\"button\"\n              class=\"w-full bg-gradient-to-r from-primary to-[#5b54e5] hover:opacity-90 active:scale-[0.98] transition-all text-primary-foreground font-medium py-3.5 rounded-squircle shadow-md shadow-primary/20 flex items-center justify-center gap-2\"\n            >\n              <span>Đăng nhập</span\n              ><iconify-icon icon=\"solar:arrow-right-linear\" width=\"20\" height=\"20\"></iconify-icon>\n            </button>\n          </div>\n        </div>\n      </div>\n      <div class=\"fixed inset-0 z-50 flex flex-col justify-end\">\n        <div class=\"absolute inset-0 bg-foreground/20 backdrop-blur-[2px]\"></div>\n        <div\n          class=\"relative w-full bg-card rounded-t-[1.5rem] shadow-2xl border-t border-border px-4 pb-8 pt-3 flex flex-col max-h-[85vh]\"\n        >\n          <div class=\"w-10 h-1.5 bg-muted-foreground/20 rounded-full mx-auto mb-6\"></div>\n          <div class=\"space-y-1.5 px-1 mb-6\">\n            <h2 class=\"text-xl font-semibold font-heading tracking-tight text-foreground\">\n              Chọn không gian làm việc\n            </h2>\n            <p class=\"text-sm text-muted-foreground\">\n              Tài khoản của bạn đang tham gia nhiều không gian.\n            </p>\n          </div>\n          <div class=\"space-y-3 overflow-y-auto pb-4\">\n            <button\n              type=\"button\"\n              class=\"w-full flex items-center gap-4 p-4 rounded-squircle border border-primary/30 bg-primary/5 hover:bg-primary/10 transition-colors group text-left relative overflow-hidden\"\n            >\n              <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-primary rounded-r-full\"></div>\n              <div\n                class=\"size-12 rounded-squircle bg-white border border-border/50 flex items-center justify-center shrink-0 shadow-sm\"\n              >\n                <span class=\"text-lg font-bold text-primary font-heading\">TNP</span>\n              </div>\n              <div class=\"flex-1 min-w-0\">\n                <h3 class=\"text-base font-semibold text-foreground truncate\">Công ty TNHH TNP</h3>\n                <p class=\"text-xs text-muted-foreground truncate mt-0.5\">\n                  32 nhân viên · Gói Doanh nghiệp\n                </p>\n              </div>\n              <iconify-icon\n                icon=\"solar:check-circle-bold\"\n                class=\"text-primary shrink-0\"\n                width=\"24\"\n                height=\"24\"\n              ></iconify-icon></button\n            ><button\n              type=\"button\"\n              class=\"w-full flex items-center gap-4 p-4 rounded-squircle border border-border bg-card hover:bg-muted/50 transition-colors group text-left\"\n            >\n              <div\n                class=\"size-12 rounded-squircle bg-muted flex items-center justify-center shrink-0 border border-border/50\"\n              >\n                <span class=\"text-lg font-bold text-muted-foreground font-heading\">V</span>\n              </div>\n              <div class=\"flex-1 min-w-0\">\n                <h3 class=\"text-base font-medium text-foreground truncate\">Vinhomes Sales</h3>\n                <p class=\"text-xs text-muted-foreground truncate mt-0.5\">Dự án Q9</p>\n              </div>\n              <iconify-icon\n                icon=\"solar:alt-arrow-right-linear\"\n                class=\"text-muted-foreground group-hover:text-foreground shrink-0 transition-colors\"\n                width=\"20\"\n                height=\"20\"\n              ></iconify-icon>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </body>\n</html>\n","createdAt":"2026-08-03T02:51:11.944678+00:00"}],"createdAt":"2026-08-03T02:51:11.944678+00:00","updatedAt":"2026-08-03T02:51:11.944678+00:00"}}